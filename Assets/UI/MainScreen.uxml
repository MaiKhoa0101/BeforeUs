<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn chính vòng lượt (A1). Khung tĩnh thôi: mọi chữ do MainScreenController đổ vào lúc chạy,
  lấy từ Assets/Data/strings.vi.json. Không viết cứng tiếng Việt ở đây (AGENTS.md).
  Thiết kế cho màn hình NGANG (docs/decisions.md D8).
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="MainScreen.uss" />


    <ui:VisualElement name="community-screen" class="screen hidden">

        <ui:VisualElement name="c-header" class="header" />
        <ui:VisualElement name="c-top-hints" class="hint-slot" />

        <ui:VisualElement name="c-climate" class="climate-banner hidden">
            <ui:Label name="c-climate-text" class="climate-banner-text" />
            <ui:VisualElement name="c-climate-hint" class="hint-slot" />
        </ui:VisualElement>

        <ui:VisualElement name="c-status" class="status-row">
            <ui:Label name="c-energy" class="energy-label" />
            <ui:VisualElement name="c-energy-pips" class="energy-pips" />
            <ui:VisualElement name="c-morale" class="morale-box">
                <ui:Label name="c-morale-label" class="morale-label" />
                <ui:VisualElement class="morale-track">
                    <ui:VisualElement name="c-morale-fill" class="morale-fill" />
                </ui:VisualElement>
                <ui:Label name="c-morale-hint" class="morale-hint" />
            </ui:VisualElement>
            <ui:Label name="c-screen-hint" class="plan-rule-label" />
            <ui:Button name="c-hints-toggle" class="small-button" />
            <ui:Button name="c-hint-catalog" class="small-button" />
            <ui:Button name="c-classic" class="small-button" />
        </ui:VisualElement>

        <ui:VisualElement name="c-body" class="community-body">

            <ui:VisualElement name="c-left" class="community-side">
                <ui:Button name="c-food-nest" class="community-object" />
            </ui:VisualElement>

            <ui:VisualElement name="c-center" class="community-center">
                <ui:Label name="c-title" class="community-center-title" />
                <ui:VisualElement name="c-row-back" class="slot-row" />
                <ui:Button name="c-hub" class="community-hub" />
                <ui:VisualElement name="c-hub-hint" class="hint-slot" />
                <ui:VisualElement name="c-row-front" class="slot-row" />
            </ui:VisualElement>

            <ui:VisualElement name="c-right" class="community-side">
                <ui:Button name="c-club" class="community-object" />
                <ui:Button name="c-trail" class="community-object" />
                <ui:Label name="c-sites-title" class="community-side-title" />
                <ui:ScrollView name="c-sites-scroll" class="community-sites-scroll">
                    <ui:VisualElement name="c-sites" class="community-sites" />
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="c-task" class="task-panel hidden">
            <ui:VisualElement class="task-head">
                <ui:Label name="c-task-title" class="task-title" />
                <ui:Label name="c-task-party" class="task-party" />
                <ui:Button name="c-task-clear" class="small-button" />
                <ui:Button name="c-task-close" class="small-button" />
            </ui:VisualElement>
            <ui:Label name="c-task-detail" class="task-detail" />
            <ui:VisualElement name="c-task-lines" class="task-lines" />
            <ui:VisualElement name="c-migrate" class="migrate-panel hidden">
                <ui:Label name="c-migrate-title" class="migrate-title" />
                <ui:Label name="c-migrate-left" class="migrate-left" />
                <ui:VisualElement name="c-migrate-list" class="migrate-list" />
                <ui:VisualElement class="migrate-foot">
                    <ui:Label name="c-migrate-chosen" class="migrate-chosen" />
                    <ui:Button name="c-migrate-all" class="small-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="c-task-message" class="activity-message hidden" />
        </ui:VisualElement>


        <ui:VisualElement name="c-member-bar" class="member-bar">
            <ui:Label name="c-member-bar-title" class="member-bar-title" />
            <ui:ScrollView name="c-member-bar-scroll" class="member-bar-scroll" mode="Horizontal">
                <ui:VisualElement name="c-member-cards" class="member-cards" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="c-footer" class="community-footer">
            <ui:VisualElement name="c-forecast" class="forecast community-forecast">
                <ui:Label name="c-forecast-need" class="forecast-number" />
                <ui:Label name="c-forecast-have" class="forecast-number" />
                <ui:Label name="c-forecast-expected" class="forecast-number" />
                <ui:Label name="c-forecast-status" class="forecast-status" />
            </ui:VisualElement>
            <ui:Button name="c-end-turn" class="end-turn-button" />
        </ui:VisualElement>

    </ui:VisualElement>

    <ui:VisualElement name="screen" class="screen">

        <ui:VisualElement name="header" class="header" />

        <ui:VisualElement name="top-hints" class="hint-slot" />

        <ui:VisualElement name="climate-banner" class="climate-banner hidden">
            <ui:Label name="climate-banner-text" class="climate-banner-text" />
            <ui:VisualElement name="climate-hint" class="hint-slot" />
        </ui:VisualElement>

        <ui:VisualElement name="status-row" class="status-row">
            <ui:Label name="energy-label" class="energy-label" />
            <ui:VisualElement name="energy-pips" class="energy-pips" />
            <ui:VisualElement name="morale-box" class="morale-box">
                <ui:Label name="morale-label" class="morale-label" />
                <ui:VisualElement class="morale-track">
                    <ui:VisualElement name="morale-fill" class="morale-fill" />
                </ui:VisualElement>
                <ui:Label name="morale-hint" class="morale-hint" />
            </ui:VisualElement>
            <ui:Label name="plan-rule-label" class="plan-rule-label" />
            <ui:Button name="screen-toggle" class="small-button" />
            <ui:Button name="network-button" class="small-button small-button-strong" />
            <ui:Button name="hints-toggle" class="small-button" />
            <ui:Button name="hint-catalog-button" class="small-button" />
        </ui:VisualElement>

        <ui:VisualElement name="forecast" class="forecast">
            <ui:Label name="forecast-title" class="forecast-title" />
            <ui:VisualElement class="forecast-numbers">
                <ui:Label name="forecast-need" class="forecast-number" />
                <ui:Label name="forecast-have" class="forecast-number" />
                <ui:Label name="forecast-status" class="forecast-status" />
            </ui:VisualElement>
            <ui:Label name="forecast-note" class="forecast-note" />
        </ui:VisualElement>

        <ui:VisualElement name="body" class="body">

            <ui:VisualElement name="activities-pane" class="pane pane-activities">
                <ui:Label name="hint-label" class="hint-label" />
                <ui:ScrollView name="activity-scroll" class="activity-scroll">
                    <ui:VisualElement name="activity-list" class="activity-list" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="members-pane" class="pane pane-members">
                <ui:Label name="members-title" class="pane-title" />
                <ui:ScrollView name="member-scroll" class="member-scroll">
                    <ui:VisualElement name="member-list" class="member-list" />
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="footer" class="footer">
            <ui:Button name="end-turn-button" class="end-turn-button" />
        </ui:VisualElement>







    </ui:VisualElement>

    <!-- Lớp phủ dùng CHUNG cho cả hai màn, nên phải nằm ở MỨC GỐC.
         Trước đây chúng nằm trong màn A1: bật màn cộng đồng là ẩn luôn bảng kết quả,
         màn thắng/thua, menu đầu ván và màn mạng lưới neuron. -->
    <ui:VisualElement name="result-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog">
            <ui:Label name="result-title" class="dialog-title" />
            <ui:ScrollView class="dialog-scroll">
                <ui:VisualElement name="result-lines" class="result-lines" />
            </ui:ScrollView>
            <ui:Button name="result-continue" class="dialog-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="hint-catalog-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog">
            <ui:Label name="hint-catalog-title" class="dialog-title" />
            <ui:ScrollView class="dialog-scroll">
                <ui:VisualElement name="hint-catalog-lines" class="result-lines" />
            </ui:ScrollView>
            <ui:VisualElement class="dialog-buttons">
                <ui:Button name="hint-catalog-reset" class="dialog-button dialog-button-quiet" />
                <ui:Button name="hint-catalog-close" class="dialog-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="neuron-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog dialog-wide">
            <ui:Label name="neuron-title" class="dialog-title" />
            <ui:VisualElement class="neuron-head">
                <ui:Label name="neuron-stage" class="neuron-head-line" />
                <ui:Label name="neuron-have" class="neuron-head-line neuron-have" />
                <ui:Label name="neuron-feats" class="neuron-head-line" />
            </ui:VisualElement>
            <ui:Label name="neuron-message" class="neuron-message hidden" />
            <ui:ScrollView class="dialog-scroll">
                <ui:Label name="neuron-nonodes" class="dialog-body hidden" />
                <ui:VisualElement name="neuron-branches" class="neuron-branches" />
                <ui:VisualElement name="neuron-evolve" class="neuron-evolve" />
            </ui:ScrollView>
            <ui:Button name="neuron-close" class="dialog-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="menu-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog dialog-centered">
            <ui:Label name="menu-title" class="menu-title" />
            <ui:Label name="menu-body" class="dialog-body" />
            <ui:Button name="menu-newgame" class="dialog-button dialog-button-centered" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="evolve-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog dialog-evolve">
            <ui:Label name="evolve-title" class="dialog-title" />
            <ui:Label name="evolve-body" class="dialog-body" />
            <ui:VisualElement name="evolve-lines" class="result-lines" />
            <ui:Button name="evolve-continue" class="dialog-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="end-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog">
            <ui:Label name="end-title" class="dialog-title" />
            <ui:Label name="end-body" class="dialog-body" />
            <ui:VisualElement name="end-lines" class="result-lines end-lines" />
            <ui:Button name="end-button" class="dialog-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="hub-overlay" class="overlay hidden">
        <ui:VisualElement class="dialog dialog-wide">
            <ui:Label name="hub-title" class="dialog-title" />
            <ui:ScrollView class="dialog-scroll">
                <ui:VisualElement name="hub-sections" class="hub-sections" />
            </ui:ScrollView>
            <ui:Button name="hub-close" class="dialog-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
