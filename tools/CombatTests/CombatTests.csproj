<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chạy bằng: dotnet test tools/CombatTests

       NUnit ở đây là 3.14.0 vì nó phải CHẠY được trên .NET 10. Bản 3.5.0 mà Unity nạp chỉ có
       assembly .NET Framework 4.5 và tham chiếu System.Runtime.Remoting / System.Web, nên nạp
       vào .NET 10 là nổ ngay lúc dò test.

       NHƯNG 3.14.0 có những API mà Unity KHÔNG có (Is.AnyOf từ 3.11, Does.Contain nạp chồng cho
       tập hợp...). Viết trúng một cái là `dotnet test` xanh còn Unity đỏ, và lỗi chỉ lộ ra khi
       Khoa mở Editor — lúc đó Unity không vào được Play Mode. Đã xảy ra thật.

       Chỗ chặn là tools/CombatTests/UnityApiGate: cùng mã nguồn test, biên dịch lại bằng đúng
       NUnit 3.5.0, KHÔNG chạy. Nó được build kèm bộ test này nên không quên được. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>BeforeUs.Combat.Tests</AssemblyName>
    <RootNamespace>BeforeUs.Combat.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Combat.Tests/**/*.cs" LinkBase="Combat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CombatLib/BeforeUs.Combat.csproj" />

    <!-- Cổng API Unity. ReferenceOutputAssembly=false + PrivateAssets=all: chỉ BUILD nó,
         không nhận assembly hay package nào từ nó (nếu không, NUnit 3.5.0 sẽ tràn sang đây
         và làm hỏng đúng cái nó sinh ra để bảo vệ). -->
    <ProjectReference Include="UnityApiGate/UnityApiGate.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
