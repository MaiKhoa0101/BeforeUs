<Project Sdk="Microsoft.NET.Sdk">

  <!-- Biên dịch mã nguồn nhánh combat ngoài Unity, song song với tools/CoreTests/CoreLib.
       netstandard2.1 + LangVersion 9 ép đúng trần API/cú pháp của Unity 6000.6.7f1 (decisions.md D10),
       và không có UnityEngine trong tầm với: asmdef noEngineReferences được kiểm chứng bằng compiler. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>BeforeUs.Combat</AssemblyName>
    <RootNamespace>BeforeUs.Combat</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Combat/**/*.cs" LinkBase="Combat" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../CoreTests/CoreLib/BeforeUs.Core.csproj" />
  </ItemGroup>

</Project>
